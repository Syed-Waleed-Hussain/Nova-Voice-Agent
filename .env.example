# =====================================================================
# Groq Voice Assistant - Environment Variables
# =====================================================================

# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq LLM model: llama-3.3-70b-versatile, llama-3.1-70b-versatile, or llama3-70b-8192
GROQ_MODEL=llama-3.1-8b-instant

# Groq STT Whisper model: whisper-large-v3-turbo or whisper-large-v3
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Default Edge-TTS voice (e.g. en-US-AriaNeural, en-US-GuyNeural, ur-PK-UzmaNeural, en-GB-SoniaNeural)
DEFAULT_VOICE=en-US-AriaNeural

# Optional Search API Key (DuckDuckGo Search works automatically for free without a key)
TAVILY_API_KEY=

# Server settings
HOST=127.0.0.1
PORT=8000

